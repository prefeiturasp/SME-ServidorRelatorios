@using SME.SR.Infra.Dtos.NovoSondagem
@using SME.SR.HtmlPdf
@model QuestionarioSondagemRelatorioDto

@{
    var colunas = Model.Estudantes?
        .FirstOrDefault()?.Coluna?.ToList()
        ?? new List<ColunaQuestionarioDto>();
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@@400;500;700&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Roboto', 'DejaVu Sans', Arial, sans-serif;
            font-size: 10px;
            color: #42474A;
            background: #fff;
            padding: 0 16px;
            margin-top: 16px;
            margin-bottom: 0;
            letter-spacing: 0.02em;
            word-spacing: 0.05em;
        }

        .report-title {
            text-align: center;
            margin-bottom: 16px;
            margin-top: 0;
        }

            .report-title h1 {
                font-size: 14px;
                font-weight: 700;
                color: #42474A;
                margin-bottom: 4px;
                line-height: 1.2;
            }

            .report-title h2 {
                font-size: 10px;
                font-weight: 400;
                color: #42474A;
                line-height: 12px;
            }

        .main-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0;
            table-layout: fixed;
        }

            .main-table thead {
                display: table-header-group;
            }

            .main-table tbody {
                display: table-row-group;
            }

            .main-table th {
                border: 1px solid #F0F0F0;
                padding: 8px;
                text-align: center;
                vertical-align: middle;
                font-family: 'Roboto', 'DejaVu Sans', Arial, sans-serif;
                font-size: 10px;
                font-weight: 700;
                line-height: 12px;
                background-color: #FAFAFA;
                color: #42474A;
                word-break: normal;
                overflow-wrap: break-word;
            }

            .main-table thead th.col-nome {
                text-align: left;
                padding: 0 8px;
            }

            .main-table td {
                border: 1px solid #F0F0F0;
                padding: 0 8px;
                text-align: center;
                vertical-align: middle;
                font-family: 'Roboto', 'DejaVu Sans', Arial, sans-serif;
                font-size: 10px;
                font-weight: 400;
                line-height: 12px;
                color: #42474A;
                word-break: normal;
                overflow-wrap: break-word;
                background-color: #FFFFFF;
            }

            .main-table tbody tr {
                page-break-inside: avoid;
            }

        .col-num {
            width: 4.97%;
        }

        .col-nome {
            width: 21.31%;
        }

        .col-raca {
            width: 10.83%;
        }

        .col-genero {
            width: 11.19%;
        }

        .col-lp {
            width: 10.12%;
        }

        .col-resp {
            width: 8.31%;
        }

        .main-table tbody td.col-nome,
        .main-table tbody td.col-raca,
        .main-table tbody td.col-genero {
            text-align: left;
            padding: 8px;
            word-break: normal;
            overflow-wrap: break-word;
        }

        .main-table td.col-resp {
            padding: 4px;
            font-weight: 500;
            font-size: 10px;
            line-height: 12px;
        }

        .aluno-nome {
            font-size: 10px;
            font-weight: 400;
            line-height: 12px;
            color: #42474A;
        }

        .badges-container {
            margin-top: 4px;
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            align-items: center;
        }

        .badge-icon {
            height: 12px;
            vertical-align: middle;
        }

        .checkbox-lp {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 1.5px solid #BFBFC2;
            border-radius: 2px;
            background-color: #fff;
            vertical-align: middle;
        }

            .checkbox-lp.checked {
                background-color: #6933FF;
                border-color: #6933FF;
                color: #fff;
                font-size: 11px;
                font-weight: 700;
                text-align: center;
                line-height: 15px;
            }

        .resposta-vazio {
            color: #BFBFC2;
            font-style: normal;
            font-weight: 500;
            font-size: 10px;
            line-height: 12px;
        }
    </style>
</head>
<body>

    <div class="report-title">
        <h1>Relatório da Sondagem</h1>
        <h2>@Model.TituloTabelaRespostas</h2>
    </div>

    <table class="main-table">
        <thead>
            <tr class="th-group">
                <th rowspan="2" class="col-num">N°</th>
                <th rowspan="2" class="col-nome">Nome</th>
                <th rowspan="2" class="col-raca">Raça</th>
                <th rowspan="2" class="col-genero">Gênero</th>
                <th rowspan="2" class="col-lp">LP como 2° língua?</th>
                <th colspan="@colunas.Count">@Model.TituloTabelaRespostas</th>
            </tr>

            <tr class="th-cols">
                @foreach (var coluna in colunas)
                {
                    <th class="col-resp">@coluna.DescricaoColuna</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Estudantes != null)
            {
                foreach (var estudante in Model.Estudantes)
                {
                    <tr>
                        <td class="col-num">@estudante.NumeroAlunoChamada</td>

                        <td class="col-nome aluno-nome">
                            @estudante.Nome
                            @if (estudante.Aee || estudante.Pap || estudante.PossuiDeficiencia)
                            {
                                <div class="badges-container">
                                    @if (estudante.Aee)
                                    {
                                        <img src="logoAEE.png" class="badge-icon" alt="AEE" title="Atendimento Educacional Especializado" />
                                    }
                                    @if (estudante.Pap)
                                    {
                                        <img src="logoPAP.png" class="badge-icon" alt="PAP" title="Programa de Acompanhamento Pedagógico" />
                                    }
                                    @if (estudante.PossuiDeficiencia)
                                    {
                                        <img src="logoAcessibilidade.png" class="badge-icon" alt="Deficiência" title="Possui Deficiência" />
                                    }
                                </div>
                            }
                        </td>

                        <td class="col-raca">@estudante.Raca</td>
                        <td class="col-genero">@estudante.Genero</td>

                        <td class="col-lp">
                            @if (estudante.LinguaPortuguesaSegundaLingua)
                            {
                                <span class="checkbox-lp checked">&#10003;</span>
                            }
                            else
                            {
                                <span class="checkbox-lp"></span>
                            }
                        </td>

                        @foreach (var coluna in colunas)
                        {
                            var colunaEstudante = estudante.Coluna?
                                .FirstOrDefault(c => c.IdCiclo == coluna.IdCiclo
                                                  && c.QuestaoSubrespostaId == coluna.QuestaoSubrespostaId);

                            var opcaoResposta = colunaEstudante != null
                                && colunaEstudante.Resposta?.OpcaoRespostaId != null
                                && colunaEstudante.OpcaoResposta != null
                                ? colunaEstudante.OpcaoResposta
                                    .FirstOrDefault(o => o.Id == colunaEstudante.Resposta.OpcaoRespostaId)
                                : null;

                            if (colunaEstudante?.Resposta == null)
                            {
                                <td class="col-resp">
                                    <span class="resposta-vazio">-</span>
                                </td>
                            }
                            else if (opcaoResposta == null)
                            {
                                <td class="col-resp">
                                    <span class="resposta-vazio">Vazio</span>
                                </td>
                            }
                            else
                            {
                                <td class="col-resp"
                                    style="background-color: @(opcaoResposta.CorFundo ?? "transparent"); color: @(opcaoResposta.CorTexto ?? "#333");">
                                    @(opcaoResposta.DescricaoOpcaoResposta ?? opcaoResposta.Legenda)
                                </td>
                            }
                        }
                    </tr>
                }
            }
        </tbody>
    </table>

</body>
</html>